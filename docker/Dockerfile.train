# syntax=docker/dockerfile:1

# ---- Stage 1: base with dependencies -------------------------------------
FROM python:3.11-slim AS base
WORKDIR /app

# Build tools needed only to compile wheels; not present in final layer
# because we only ever build this one stage (no further copy of apt cache).
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/train.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r train.txt

# ---- Stage 2: training runtime ---------------------------------------------
FROM base AS training

COPY src/ ./src/
COPY configs/ ./configs/

ENV PYTHONUNBUFFERED=1 \
    TRAINING_CONFIG_PATH=/app/configs/training_config.yaml

# Data and checkpoints are expected to be mounted volumes at runtime
# (see k8s/training-job.yaml PVC mounts, or `docker run -v ...`).
VOLUME ["/app/data", "/app/checkpoints"]

WORKDIR /app/src
ENTRYPOINT ["python", "train.py"]
